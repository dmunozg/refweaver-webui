# Postgres service configuration
POSTGRES_DB=refweaver_webui
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Service ports exposed to the host
BFF_PORT=3001
WEB_PORT=5173
WEB_BIND_ADDRESS=127.0.0.1

# Application runtime configuration
DATABASE_URL=postgres://postgres:postgres@db:5432/refweaver_webui
BETTER_AUTH_SECRET=replace-with-random-secret
BETTER_AUTH_URL=http://localhost:3001
REFWEAVER_API_BASE_URL=
REFWEAVER_API_KEY=
BFF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_BFF_BASE_URL=http://localhost:3001
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
